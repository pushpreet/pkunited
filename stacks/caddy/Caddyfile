:80 {

	# --- ERPNext ---
	@erpnext {
		host erp.pushprh.com
	}
	reverse_proxy @erpnext erpnext-frontend:8080 {
		header_up Host erp.pushprh.com
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}

	# --- n8n ---
	# n8n handles its own authentication (User Management mode)
	@n8n {
		host n8n.pushprh.com
	}
	reverse_proxy @n8n n8n:5678 {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}
}
