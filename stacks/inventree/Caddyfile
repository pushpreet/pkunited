# InvenTree internal proxy — serves static/media and reverse-proxies to gunicorn.
:80 {
    # Static files (React frontend)
    root * /var/www/static
    @static path /static/*
    file_server @static

    # Media files (user uploads, part images, etc.)
    root * /var/www/media
    @media path /media/*
    file_server @media

    # Everything else → gunicorn backend
    reverse_proxy inventree:8000 {
        header_up Host inventree.pushprh.com
        header_up X-Forwarded-Proto https
    }
}
